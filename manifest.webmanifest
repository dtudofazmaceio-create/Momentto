{
  "name": "FotoEvento — álbum de fotos do evento",
  "short_name": "FotoEvento",
  "description": "Álbum colaborativo de fotos para casamentos, 15 anos e eventos.",
  "lang": "pt-BR",
  "start_url": "./?app=1",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
